Subject: [PATCH] Zero-initialize finite-difference weight workspace

---
 .../finitedifferences/operators/numericaldifferentiation.cpp    | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/ql/methods/finitedifferences/operators/numericaldifferentiation.cpp b/ql/methods/finitedifferences/operators/numericaldifferentiation.cpp
index d4ecbd3..6f697f4 100644
--- a/ql/methods/finitedifferences/operators/numericaldifferentiation.cpp
+++ b/ql/methods/finitedifferences/operators/numericaldifferentiation.cpp
@@ -28,6 +28,7 @@
 #include <boost/multi_array.hpp>
 #pragma pop_macro("BOOST_DISABLE_ASSERTS")
 
+#include <algorithm>
 #include <utility>
 
 namespace QuantLib {
@@ -72,6 +73,7 @@ namespace QuantLib {
             QL_DEPRECATED_DISABLE_WARNING
             boost::multi_array<Real, 3>  d(boost::extents[M+1][N][N]);
             QL_DEPRECATED_ENABLE_WARNING
+            std::fill(d.data(), d.data() + d.num_elements(), 0.0);
             d[0][0][0] = 1.0;
             Real c1 = 1.0;
 
